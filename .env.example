# Neon Auth Configuration (Managed Better Auth)
VITE_NEON_AUTH_URL=https://<your-neon-auth-host>/neondb/auth
VITE_NEON_PROJECT_ID=<your-neon-project-id>

# Neon Database Connection
VITE_NEON_DATABASE_URL=postgresql://<user>:<password>@<host>/neondb?sslmode=require
DATABASE_URL=postgresql://<user>:<password>@<host>/neondb?sslmode=require
