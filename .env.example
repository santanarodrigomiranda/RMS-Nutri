# =============================================================
# RMS-Nutri - Variaveis de Ambiente
# Copie este arquivo para .env e preencha com suas credenciais
# NUNCA envie o arquivo .env real para o repositorio
# =============================================================

# -- Neon Auth ------------------------------------------------
VITE_NEON_AUTH_URL=https://seu-endpoint.neonauth.aws.neon.tech/neondb/auth
VITE_NEON_PROJECT_ID=seu-project-id

# -- Neon Database Connection ---------------------------------
VITE_NEON_DATABASE_URL=postgresql://usuario:senha@host/neondb?sslmode=require
DATABASE_URL=postgresql://usuario:senha@host/neondb?sslmode=require

# -- Google Gemini AI -----------------------------------------
# Obtenha sua chave em: https://aistudio.google.com/app/apikey
# Esta chave e usada APENAS no servidor (api/gerar-plano.ts)
# NUNCA exponha com prefixo VITE_
GEMINI_API_KEY=sua-chave-gemini-aqui
